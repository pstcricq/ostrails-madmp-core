# Environment / caches
.venv/
.coverage
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# Where the generators write, KM bundles and document template bundles, built
# from the configs and the rules and so never versioned.
# (setuptools also scratches here on `uv build`.)
build/

# Where to publish, and as whom, when a target is run by hand. The names are
# in .env.example, and DSW_PASSWORD is one of them. A password written next to
# the code that reads it is a password that gets pushed one day, so the file
# it would live in is ignored before it exists.
.env
.env.*
!.env.example

# Editor settings (personal)
.vscode/
