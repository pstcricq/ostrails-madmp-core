# Where to publish, and as whom, when a target of `dsw.publish` or a registry
# script is run by hand. Copy to `.env`, which git ignores, and fill it in.
# Source it, do not run it:
#
#     set -a; . ./.env; set +a
#
# None of these names has a default in the code, and every entry point reports
# the ones it is missing rather than assuming.

# The DSW account `dsw.publish` logs in as. Nothing in either repository holds
# these, which is why they are asked for here.
DSW_EMAIL=
DSW_PASSWORD=

# The instance, the wizard-api base URL and not the client's. On the local
# madmp-dsw stack that is port 3000, under /wizard-api.
DSW_API_URL=http://localhost:3000/wizard-api

# The webhook's address as DSW reaches it, route included. On the local stack
# that is a compose service name and not a localhost address, since DSW
# resolves it from inside its own network. `publish` only appends
# ?project=<id>, so an address without the webhook's own path writes a service
# that posts to the container root.
SUBMISSION_URL=http://submission:8080/submissions

# The shared secret the webhook checks. It has to be the one the container was
# started with, so on the local stack it is read from madmp-dsw/.env rather
# than written twice.
SUBMISSION_TOKEN=

# Which registry a project's folder lives in, and a token with Contents RW on
# it. Locally: REGISTRY_TOKEN=$(gh auth token), which leaves it nowhere.
REGISTRY_OWNER=
REGISTRY_REPO=
REGISTRY_TOKEN=
